# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_PATH=./db/spectrust.db

# Demo / Fallback Mode (Set to true to use deterministic extraction without external API keys)
DEMO_MODE=true

# API Keys (Placeholders ONLY - Do not insert real secrets)
# GEMINI_API_KEY=your_gemini_key_here
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here
